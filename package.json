{
  "name": "awwra-static",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "optimize": "node scripts/optimize.js",
    "build:html": "node scripts/build.js",
    "build:search": "pagefind --site public",
    "build": "npm run clean && npm run optimize && npm run build:html && npm run build:search",
    "dev": "npm run build && node server.js",
    "preview": "node server.js",
    "deploy": "wrangler pages deploy public --project-name=awwra"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "express": "5.3.0",
    "gray-matter": "4.0.3",
    "marked": "18.2.1",
    "pagefind": "1.6.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "wrangler": "4.165.0"
  }
}